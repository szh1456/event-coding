 "definitions": {
  "source": "directive 019 per-group outputs (hd_run.load), ec.families._Tasks.run key 'motion', placement 'start'",
  "squares": "fb_run.squares_for on the true events of window w + 2: the 10 densest 40 x 40 squares with at least 200 events; the velocity is ec.downstream.cmax_velocity (contrast maximisation) over the square, warped to (w + 2) T0; error_px = |v_dec - v_true| T0 in px per window",
  "D1": "P-picture modes qp<q> of the D1 groups of directive 019 (j % 40 == 0 eTraM, j % 20 == 0 DSEC), recordings with at least 2 (eTraM) or 1 (DSEC) groups",
  "reference": "D2: hevcdiag.represent, counts on (1, k) back to events at the voxel start, no coding, on the same D1 groups and squares as the QP points; 'reference_all_019_groups' gives it on every group of directive 019 (D1 and D2 tasks, the population of Table 2 of report 019), same recording rule",
  "undefined": "true velocity not finite; cmax_velocity is NaN only for an empty set and every square holds >= 200 true events, so none occurs; a record with NaN error and n_rec > 0 would count here",
  "failure": "decoded velocity not finite: the decode leaves no event in the square (n_rec == 0); counted as not recovered",
  "success1": "share of defined squares with error <= 1 px per window, pooled over squares of the stratum",
  "ci95": "bootstrap over recordings of the pooled share, 2000 resamples, seed 20261016",
  "fail_share": "share of defined squares that fail",
  "median_err": "median error with failures as infinite; null when fail_share >= 0.5",
  "b": "median over recordings of bits per true event of the four windows at that QP (results/hd/frontier.json)",
  "success_only_median_err": "median over recordings of the per-recording median of the finite errors: the construction of motion_error_px in results/hd/frontier.json"
 }
}
